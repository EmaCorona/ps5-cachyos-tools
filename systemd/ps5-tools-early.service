[Unit]
Description=PS5 CachyOS Tools early module tasks
DefaultDependencies=no
After=local-fs.target
Before=basic.target ps5-tools-boot.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/ps5-cachyos-tools/boot-runner early
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
