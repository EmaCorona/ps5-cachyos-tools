+	const drmModeModeInfo *CDRMConnector::FindMode( int hdisplay, int vdisplay, uint32_t vrefresh )
+	{
+		const drmModeModeInfo *mode = find_mode( GetModeConnector(), hdisplay, vdisplay, vrefresh );
+		const bool bPreferNativeEdidMode = hdisplay == 0 && vdisplay == 0 && vrefresh == 0;
+		if ( ( mode && !bPreferNativeEdidMode ) || m_EdidModes.empty() )
+			return mode;
+
+		const drmModeModeInfo *edidMode = gamescope::FindFirstUsableEDIDMode( m_EdidModes,
+			[&]( const drmModeModeInfo &candidate ) -> const drmModeModeInfo *
+			{
+				if ( ( hdisplay && hdisplay != candidate.hdisplay ) || ( vdisplay && vdisplay != candidate.vdisplay ) ||
+					( vrefresh && vrefresh != candidate.vrefresh ) )
+					return nullptr;
+
+				const drmModeModeInfo *enumeratedMode = find_mode( GetModeConnector(), candidate.hdisplay, candidate.vdisplay, candidate.vrefresh );
+				if ( enumeratedMode )
+					return enumeratedMode;
+
+				if ( !g_DRM.pCRTC || !GetProperties().CRTC_ID || !g_DRM.pCRTC->GetProperties().ACTIVE || !g_DRM.pCRTC->GetProperties().MODE_ID )
+					return nullptr;
+
+				uint32_t modeBlob = 0;
+				if ( drmModeCreatePropertyBlob( g_DRM.fd, &candidate, sizeof( candidate ), &modeBlob ) != 0 )
+					return nullptr;
+				defer( drmModeDestroyPropertyBlob( g_DRM.fd, modeBlob ) );
+				drmModeAtomicReq *request = drmModeAtomicAlloc();
+				if ( !request )
+					return nullptr;
+				defer( drmModeAtomicFree( request ) );
+				const auto &crtcProps = g_DRM.pCRTC->GetProperties();
+				int ret = drmModeAtomicAddProperty( request, GetObjectId(), GetProperties().CRTC_ID->GetPropertyId(), g_DRM.pCRTC->GetObjectId() );
+				ret |= drmModeAtomicAddProperty( request, g_DRM.pCRTC->GetObjectId(), crtcProps.ACTIVE->GetPropertyId(), 1 );
+				ret |= drmModeAtomicAddProperty( request, g_DRM.pCRTC->GetObjectId(), crtcProps.MODE_ID->GetPropertyId(), modeBlob );
+				if ( ret < 0 || drmModeAtomicCommit( g_DRM.fd, request, DRM_MODE_ATOMIC_TEST_ONLY | DRM_MODE_ATOMIC_ALLOW_MODESET, nullptr ) != 0 )
+				{
+					drm_log.warnf( "EDID mode candidate %dx%d@%u failed atomic TEST_ONLY; trying the next candidate",
+						candidate.hdisplay, candidate.vdisplay, candidate.vrefresh );
+					return nullptr;
+				}
+
+				drm_log.infof( "EDID mode candidate %dx%d@%u passed atomic TEST_ONLY",
+					candidate.hdisplay, candidate.vdisplay, candidate.vrefresh );
+				return &candidate;
+			} );
+		return edidMode ? edidMode : mode;
+	}
