#!/usr/bin/env bash
set -u
umask 077
common=${PS5_SESSION_COMMON:-/usr/local/libexec/ps5-cachyos-tools/session-common.sh}
[[ -f "$common" && ! -L "$common" ]] || { printf 'session-common.sh mancante\n' >&2; exit 1; }
# shellcheck source=/dev/null
source "$common"
if [[ ${1:-} == --session-child ]]; then
    if [[ -z ${PS5_SESSION_ID:-} ]]; then
        PS5_SESSION_ID="${PS5_SESSION_BOOT_ID:0:8}-$$"
        export PS5_SESSION_ID
    fi
else
    PS5_SESSION_ID="${PS5_SESSION_BOOT_ID:0:8}-$$"
    export PS5_SESSION_ID
fi
supervisor_path=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
policy_bin="${supervisor_path%/*}/session-policy"
drm_root=${PS5_DRM_SYSFS_ROOT:-/sys/class/drm}
drm_device=${PS5_DRM_DEVICE:-/dev/dri/card0}
timeout=${PS5_SESSION_DRM_READY_TIMEOUT_SEC:-30}
poll=${PS5_SESSION_DRM_POLL_INTERVAL_SEC:-0.1}
stable_needed=${PS5_SESSION_DRM_STABLE_SAMPLES:-3}
seat_release_timeout=${PS5_SESSION_SEAT_RELEASE_TIMEOUT_SEC:-10}
gamescope_bin=${PS5_GAMESCOPE_BIN:-/usr/local/libexec/ps5-cachyos-tools/gamescope-session}
plasma_bin=${PS5_PLASMA_BIN:-/usr/bin/startplasma-wayland}
fallback_log=${PS5_FALLBACK_LOG:-${HOME:-/home/steam}/.gamescope-fallback.log}
control_dir=$PS5_SESSION_CONTROL_DIR
pgid_file="$control_dir/gamescope.pgid"
gamescope_pid=''
active_pid=''
requested=''
PS5_SESSION_STOP_REQUESTED=0
valid_uint() { [[ $1 =~ ^[0-9]{1,4}$ ]]; }
valid_uint "$timeout" && (( timeout >= 1 && timeout <= 600 )) || timeout=30
valid_uint "$stable_needed" && (( stable_needed >= 1 && stable_needed <= 10 )) || stable_needed=3
valid_uint "$seat_release_timeout" && (( seat_release_timeout >= 1 && seat_release_timeout <= 60 )) || seat_release_timeout=10
[[ $poll =~ ^[0-9]+([.][0-9]{1,2})?$ ]] || poll=0.1

consume_matching_next_session() {
    # NEXT_SESSION is one-shot: clear it once the requested session is honoured.
    local chosen=$1
    ps5_session_read_config "$PS5_SESSION_CONFIG" || return 0
    if [[ -n $PS5_SESSION_NEXT && $PS5_SESSION_NEXT == "$chosen" ]]; then
        if ps5_session_write_config "$PS5_SESSION_DEFAULT" ''; then
            ps5_session_log info "sessione one-shot consumata: $chosen (default=$PS5_SESSION_DEFAULT)"
        else
            ps5_session_log warning 'impossibile consumare l override one-shot NEXT_SESSION'
        fi
    fi
    return 0
}

if [[ ${1:-} == --check-config ]]; then
    if [[ -e $PS5_SESSION_CONFIG || -L $PS5_SESSION_CONFIG ]]; then
        ps5_session_read_config "$PS5_SESSION_CONFIG" || exit 1
    fi
    [[ -x $policy_bin ]] || exit 1
    requested=$("$policy_bin") || exit 1
    [[ $requested == desktop || $requested == gamescope ]]
    exit $?
fi

is_session_child=0
if [[ ${1:-} == --session-child ]]; then
    is_session_child=1
    requested=${2:-}
    [[ $requested == desktop || $requested == gamescope ]] || exit 2
else
    # session-policy resolves the boot session from session.conf (KDE fallback).
    config_valid=0
    if ps5_session_read_config "$PS5_SESSION_CONFIG"; then
        config_valid=1
    elif [[ -e $PS5_SESSION_CONFIG || -L $PS5_SESSION_CONFIG ]]; then
        ps5_session_log error 'configurazione sessione invalida; uso KDE come default'
    fi
    if [[ ! -x $policy_bin ]]; then
        ps5_session_log error "policy sessione assente: $policy_bin; uso KDE come default"
        requested=desktop
    else
        requested=$("$policy_bin" 2>/dev/null) || requested=''
        if [[ $requested != desktop && $requested != gamescope ]]; then
            ps5_session_log error 'policy sessione invalida; uso KDE come default'
            requested=desktop
        else
            ps5_session_log info "policy repository seleziona $requested"
            (( config_valid )) && consume_matching_next_session "$requested"
        fi
    fi
fi
# Load the KDE profile in the long-lived supervisor too. This preserves
# explicit administrator KWin overrides across KDE→Gamescope→KDE switches.
if (( ! is_session_child )) && [[ -r /etc/profile.d/ps5-kde-environment.sh ]]; then
    # shellcheck source=/dev/null
    source /etc/profile.d/ps5-kde-environment.sh
fi
export LIBSEAT_BACKEND=logind

system_stopping() {
    [[ ${PS5_SYSTEM_STOPPING:-0} == 1 ]] && return 0
    command -v systemctl >/dev/null 2>&1 || return 1
    state=$(systemctl is-system-running 2>/dev/null || true)
    [[ $state == stopping ]] && return 0
    systemctl list-jobs 2>/dev/null | grep -Eq 'shutdown\.target|reboot\.target|poweroff\.target|halt\.target'
}

drm_fingerprint() {
    [[ -e $drm_device ]] || return 1
    local connector status mode name port fallback=''
    for connector in "$drm_root"/card*-*; do
        [[ -r $connector/status && -r $connector/modes ]] || continue
        status=$(<"$connector/status"); [[ $status == connected ]] || continue
        IFS= read -r mode < "$connector/modes" || true
        [[ $mode =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]] || continue
        name=${connector##*/}; port=${name#card*-}
        case "$port" in DP-1|HDMI-A-1) printf '%s|%s' "$name" "$mode"; return 0;; esac
        [[ -n $fallback ]] || fallback="$name|$mode"
    done
    [[ -n $fallback ]] || return 1
    printf '%s' "$fallback"
}

wait_for_drm() {
    local started_ms now_ms elapsed_ms elapsed started_sec=$SECONDS previous='' fingerprint stable=0
    if [[ ${PS5_SESSION_SKIP_DRM_WAIT:-0} == 1 ]]; then ps5_session_log info 'gate DRM saltato per test'; return 0; fi
    started_ms=$(ps5_session_monotonic_ms)
    ps5_session_log info "attesa DRM: device=$drm_device timeout=${timeout}s samples=$stable_needed"
    while :; do
        if (( PS5_SESSION_STOP_REQUESTED )) || system_stopping; then return 2; fi
        if ps5_session_control_take_request; then
            if [[ $PS5_SESSION_SWITCH_TARGET != gamescope ]]; then
                requested=$PS5_SESSION_SWITCH_TARGET
                ps5_session_log info "richiesta live durante attesa DRM: $requested"
                consume_matching_next_session "$requested"
                return 3
            fi
        fi
        fingerprint=$(drm_fingerprint 2>/dev/null || true)
        if [[ -n $fingerprint ]]; then
            if [[ $fingerprint == "$previous" ]]; then stable=$((stable + 1)); else previous=$fingerprint; stable=1; fi
            if (( stable >= stable_needed )); then ps5_session_log info "DRM pronto: $fingerprint"; return 0; fi
        else
            previous=''; stable=0
        fi
        now_ms=$(ps5_session_monotonic_ms)
        if [[ $started_ms =~ ^[0-9]+$ && $now_ms =~ ^[0-9]+$ ]]; then
            elapsed_ms=$((now_ms - started_ms))
            elapsed=$((elapsed_ms / 1000))
        else
            elapsed=$((SECONDS - started_sec))
            elapsed_ms=$((elapsed * 1000))
        fi
        if (( elapsed_ms >= timeout * 1000 )); then ps5_session_log error "timeout DRM dopo ${elapsed}s"; return 1; fi
        sleep "$poll" || true
    done
}

prepare_kde() {
    [[ -x $plasma_bin ]] || { ps5_session_log error "KDE non disponibile: $plasma_bin"; return 127; }
    [[ -r /etc/profile.d/ps5-kde-environment.sh ]] && source /etc/profile.d/ps5-kde-environment.sh
    unset WAYLAND_DISPLAY DISPLAY
    export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE KDE_SESSION_VERSION=6
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service plasma-xdg-desktop-portal-kde.service xdg-desktop-portal-kde.service 2>/dev/null || true
        systemctl --user import-environment XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP KDE_SESSION_VERSION KWIN_DRM_PREFER_COLOR_DEPTH KWIN_DRM_NO_DIRECT_SCANOUT KWIN_FORCE_ASSUME_HDR_SUPPORT KWIN_FORCE_SW_CURSOR 2>/dev/null || true
    fi
    if command -v dbus-update-activation-environment >/dev/null 2>&1 && [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
        dbus-update-activation-environment --systemd XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP KDE_SESSION_VERSION KWIN_DRM_PREFER_COLOR_DEPTH KWIN_DRM_NO_DIRECT_SCANOUT KWIN_FORCE_ASSUME_HDR_SUPPORT KWIN_FORCE_SW_CURSOR 2>/dev/null || true
    fi
    if [[ -x /usr/lib/plasma-dbus-run-session-if-needed && ${PS5_FORCE_TTY1:-0} != 1 ]]; then
        /usr/lib/plasma-dbus-run-session-if-needed "$plasma_bin"
    elif [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} || ${PS5_FORCE_TTY1:-0} == 1 ]]; then
        "$plasma_bin"
    elif command -v dbus-run-session >/dev/null 2>&1; then
        dbus-run-session -- "$plasma_bin"
    else
        ps5_session_log error 'dbus-run-session assente; impossibile inizializzare Plasma'; return 127
    fi
}

clear_kde_environment() {
    local variables=(WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP KDE_SESSION_VERSION KWIN_DRM_PREFER_COLOR_DEPTH KWIN_DRM_NO_DIRECT_SCANOUT KWIN_FORCE_ASSUME_HDR_SUPPORT KWIN_FORCE_SW_CURSOR)
    if command -v systemctl >/dev/null 2>&1; then systemctl --user unset-environment "${variables[@]}" 2>/dev/null || true; fi
    # Keep the configured KWin overrides in the supervisor for a later KDE
    # launch. The Gamescope child receives them filtered explicitly.
    unset WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP KDE_SESSION_VERSION
}

reap_if_zombie() {
    local pid=$1 state=''
    [[ $pid =~ ^[1-9][0-9]{0,9}$ ]] || return 0
    [[ -r "/proc/$pid/stat" ]] || return 0
    state=$(awk '{ s = $0; sub(/^.*\) /, "", s); print substr(s, 1, 1) }' "/proc/$pid/stat" 2>/dev/null || true)
    if [[ $state == Z ]]; then
        wait "$pid" 2>/dev/null || true
    fi
}

terminate_process_group() {
    local pid=$1 attempt
    [[ $pid =~ ^[1-9][0-9]{0,9}$ ]] || return 0
    kill -TERM -- "-$pid" 2>/dev/null || true
    for attempt in {1..20}; do
        reap_if_zombie "$pid"
        kill -0 -- "-$pid" 2>/dev/null || break
        sleep 0.05 || true
    done
    reap_if_zombie "$pid"
    if kill -0 -- "-$pid" 2>/dev/null; then
        kill -KILL -- "-$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
}

systemd_unit_state() {
    local unit=$1 output
    command -v systemctl >/dev/null 2>&1 || return 1
    output=$(systemctl --user show "$unit" -p LoadState -p ActiveState --value 2>/dev/null) || return 1
    [[ $output == *$'\n'* ]] || return 1
    printf '%s\n' "$output"
}

stop_kde_units() {
    local unit state load_state stop_rc=0
    local units=(plasma-workspace-wayland.target plasma-core.target plasma-kwin_wayland.service plasma-plasmashell.service xdg-desktop-portal.service plasma-xdg-desktop-portal-kde.service xdg-desktop-portal-kde.service xdg-desktop-portal-gtk.service)
    local loaded_units=()
    command -v systemctl >/dev/null 2>&1 || return 1
    for unit in "${units[@]}"; do
        state=$(systemctl --user show "$unit" -p LoadState -p ActiveState --value 2>/dev/null) || {
            ps5_session_log warning "stato systemd non leggibile per $unit"
            stop_rc=1
            continue
        }
        load_state=${state%%$'\n'*}
        if [[ $load_state == not-found ]]; then
            ps5_session_log info "unità KDE opzionale assente, ignorata: $unit"
            continue
        fi
        loaded_units+=("$unit")
    done
    if (( ${#loaded_units[@]} > 0 )); then
        if ! systemctl --user stop "${loaded_units[@]}" 2>/dev/null; then
            for unit in "${loaded_units[@]}"; do
                systemctl --user stop "$unit" 2>/dev/null || {
                    ps5_session_log warning "systemd non ha arrestato $unit"
                    stop_rc=1
                }
            done
        fi
    fi
    return "$stop_rc"
}

wait_for_kde_compositor_stop() {
    local started=$SECONDS state load_state active_state
    command -v systemctl >/dev/null 2>&1 || {
        ps5_session_log error 'systemctl --user assente; impossibile verificare l’arresto di KWin'
        return 1
    }
    while :; do
        state=$(systemd_unit_state plasma-kwin_wayland.service) || {
            ps5_session_log error 'stato plasma-kwin_wayland.service non verificabile; Gamescope non verrà avviato'
            return 1
        }
        load_state=${state%%$'\n'*}
        active_state=${state#*$'\n'}
        if [[ $load_state == loaded && ( $active_state == inactive || $active_state == failed ) ]]; then
            ps5_session_log info "compositor KWin fermo (ActiveState=$active_state)"
            return 0
        fi
        if (( SECONDS - started >= seat_release_timeout )); then
            ps5_session_log error "timeout arresto KWin dopo ${seat_release_timeout}s (LoadState=$load_state ActiveState=$active_state)"
            return 1
        fi
        sleep 0.1 || true
    done
}

verify_single_user_session() {
    local session_id=${XDG_SESSION_ID:-} uid session_user session_class session_seat session_active
    local sessions user_sessions other_id other_uid other_user other_class line parsed_sessions=0 current_session_listed=0 user_session
    command -v loginctl >/dev/null 2>&1 || {
        ps5_session_log error 'loginctl assente; impossibile verificare l’ownership della sessione KDE'
        return 3
    }
    [[ $session_id =~ ^[0-9]{1,10}$ ]] || {
        ps5_session_log error 'XDG_SESSION_ID mancante o invalido; cleanup KDE annullato per sicurezza'
        return 3
    }
    uid=$(id -u) || return 3
    session_user=$(loginctl show-session "$session_id" -p User --value 2>/dev/null) || return 3
    session_class=$(loginctl show-session "$session_id" -p Class --value 2>/dev/null) || return 3
    session_seat=$(loginctl show-session "$session_id" -p Seat --value 2>/dev/null) || return 3
    session_active=$(loginctl show-session "$session_id" -p Active --value 2>/dev/null) || return 3
    if [[ $session_user != "$uid" || $session_class != user || $session_seat != seat0 || $session_active != yes ]]; then
        ps5_session_log error "sessione KDE non verificabile come sessione attiva su seat0 (id=$session_id); cleanup annullato"
        return 3
    fi
    sessions=$(loginctl list-sessions --no-legend --no-pager 2>/dev/null) || {
        ps5_session_log error 'elenco sessioni logind non disponibile; cleanup KDE annullato'
        return 3
    }
    user_sessions=$(loginctl show-user "$uid" -p Sessions --value 2>/dev/null) || {
        ps5_session_log error 'proprietà sessioni dell’utente logind non disponibile; cleanup KDE annullato'
        return 3
    }
    [[ -n ${user_sessions//[[:space:]]/} ]] || {
        ps5_session_log error 'logind non elenca sessioni per l’utente corrente; cleanup KDE annullato'
        return 3
    }
    declare -A expected_user_sessions=() seen_sessions=()
    for user_session in $user_sessions; do
        [[ $user_session =~ ^[0-9]{1,10}$ && -z ${expected_user_sessions[$user_session]+x} ]] || {
            ps5_session_log error 'proprietà sessioni utente logind malformata; cleanup KDE annullato'
            return 3
        }
        expected_user_sessions[$user_session]=1
    done
    [[ -n ${expected_user_sessions[$session_id]+x} ]] || {
        ps5_session_log error "proprietà sessioni utente logind non include la sessione corrente $session_id; cleanup KDE annullato"
        return 3
    }
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -z ${line//[[:space:]]/} ]] && continue
        read -r other_id other_uid _ <<<"$line"
        [[ $other_id =~ ^[0-9]{1,10}$ && $other_uid =~ ^[0-9]{1,10}$ ]] || {
            ps5_session_log error 'elenco sessioni logind contiene una riga non valida; cleanup KDE annullato'
            return 3
        }
        [[ -z ${seen_sessions[$other_id]+x} ]] || {
            ps5_session_log error 'elenco sessioni logind contiene ID duplicati; cleanup KDE annullato'
            return 3
        }
        seen_sessions[$other_id]=$other_uid
        parsed_sessions=$((parsed_sessions + 1))
        if [[ $other_uid == "$uid" && -z ${expected_user_sessions[$other_id]+x} ]]; then
            ps5_session_log error "elenco sessioni logind discordante con le sessioni dell’utente corrente; cleanup KDE annullato"
            return 3
        fi
        if [[ $other_id == "$session_id" ]]; then
            [[ $other_uid == "$uid" ]] || {
                ps5_session_log error "elenco sessioni logind assegna un UID inatteso alla sessione corrente; cleanup KDE annullato"
                return 3
            }
            current_session_listed=1
            continue
        fi
        [[ $other_uid == "$uid" ]] || continue
        other_user=$(loginctl show-session "$other_id" -p User --value 2>/dev/null) || return 3
        [[ $other_user == "$uid" ]] || continue
        other_class=$(loginctl show-session "$other_id" -p Class --value 2>/dev/null) || return 3
        [[ $other_class == manager ]] && continue
        ps5_session_log error "sessione logind concorrente dello stesso UID (id=$other_id); cleanup KDE annullato"
        return 3
    done <<<"$sessions"
    if (( parsed_sessions == 0 || current_session_listed == 0 )); then
        ps5_session_log error "elenco sessioni logind vuoto o incompleto (sessione corrente $session_id assente); cleanup KDE annullato"
        return 3
    fi
    for user_session in "${!expected_user_sessions[@]}"; do
        [[ ${seen_sessions[$user_session]:-} == "$uid" ]] || {
            ps5_session_log error 'elenco sessioni logind incompleto rispetto alle sessioni dell’utente; cleanup KDE annullato'
            return 3
        }
    done
    return 0
}

wait_for_gamescope_client_exit() {
    local pgid=$1 timeout_sec=${PS5_SESSION_STEAM_SHUTDOWN_TIMEOUT_SEC:-4}
    local steps step steam_pids
    [[ $pgid =~ ^[1-9][0-9]{0,9}$ ]] || return 0
    [[ $timeout_sec =~ ^[0-9]{1,2}$ ]] || timeout_sec=4
    steps=$((timeout_sec * 20))
    command -v ps >/dev/null 2>&1 || return 0
    # Zombies (STAT Z) still report comm=steam but are already gone.
    steam_pids=$(ps -o pid=,stat=,comm= -g "$pgid" 2>/dev/null | awk '$2 !~ /^Z/ && $3 == "steam" { print $1 }' || true)
    [[ -n $steam_pids ]] || return 0
    # shellcheck disable=SC2086
    kill -TERM $steam_pids 2>/dev/null || true
    for (( step = 0; step < steps; step++ )); do
        reap_if_zombie "$pgid"
        steam_pids=$(ps -o pid=,stat=,comm= -g "$pgid" 2>/dev/null | awk '$2 !~ /^Z/ && $3 == "steam" { print $1 }' || true)
        [[ -z $steam_pids ]] && break
        sleep 0.05 || true
    done
}

cleanup_gamescope() {
    local pid=${1:-${gamescope_pid:-}}
    if [[ $pid =~ ^[1-9][0-9]{0,9}$ ]]; then
        wait_for_gamescope_client_exit "$pid"
        terminate_process_group "$pid"
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service 2>/dev/null || true
        systemctl --user reset-failed xdg-desktop-portal.service xdg-desktop-portal-gtk.service 2>/dev/null || true
        systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY 2>/dev/null || true
    fi
    [[ $pid =~ ^[1-9][0-9]{0,9}$ ]] || return 0
    rm -f -- "$pgid_file"
    gamescope_pid=''
}

cleanup_kde() {
    local pid=$1 stop_rc=0
    verify_single_user_session || return 3
    stop_kde_units || stop_rc=$?
    clear_kde_environment
    terminate_process_group "$pid"
    (( stop_rc == 0 )) || ps5_session_log warning "systemd non ha confermato l'arresto ordinato di KDE (exit=$stop_rc)"
    wait_for_kde_compositor_stop
}

report_gamescope_failure() {
    local reason=$1 anomalous=$2 alert
    if [[ $anomalous == 1 ]]; then
        ps5_session_log error "fallback KDE: $reason"
        printf '[%s] Gamescope failure: %s\n' "$(date -Is 2>/dev/null || date)" "$reason" >> "$fallback_log" 2>/dev/null || true
        alert=${PS5_ALERT_FILE:-${XDG_CONFIG_HOME:-${HOME:-/home/steam}/.config}/ps5-cachyos-tools/alert.txt}
        if [[ ! -e $alert ]]; then
            mkdir -p "${alert%/*}" 2>/dev/null || true
            printf 'Gamescope non è riuscito ad avviarsi (%s). È stato avviato KDE; il default di boot resta invariato.\n' "$reason" > "$alert" 2>/dev/null || true
        fi
    else
        ps5_session_log info "Gamescope terminato normalmente: $reason; avvio KDE senza modificare il default di boot"
    fi
}

if (( is_session_child )); then
    case "$requested" in
        desktop) prepare_kde; exit $? ;;
        gamescope)
            [[ -x $gamescope_bin ]] || exit 127
            exec env -u KWIN_DRM_PREFER_COLOR_DEPTH -u KWIN_DRM_NO_DIRECT_SCANOUT -u KWIN_FORCE_ASSUME_HDR_SUPPORT -u KWIN_FORCE_SW_CURSOR "$gamescope_bin"
            ;;
    esac
fi

stop_active_session() {
    local target=$1 pid=$2
    case "$target" in
        desktop) cleanup_kde "$pid" ;;
        gamescope) gamescope_pid=$pid; cleanup_gamescope ;;
    esac
}

launch_active_session() {
    local target=$1
    case "$target" in
        desktop)
            ps5_session_log info 'avvio KDE'
            setsid "$supervisor_path" --session-child desktop 8>&- &
            active_pid=$!
            ;;
        gamescope)
            wait_for_drm
            local wait_rc=$?
            if (( wait_rc != 0 )); then
                case "$wait_rc" in
                    2) return 2 ;;
                    3) return 3 ;;
                    *) report_gamescope_failure "DRM non pronto entro ${timeout}s" 1; requested=desktop; return 4 ;;
                esac
            fi
            if ! wait_for_kde_compositor_stop; then
                report_gamescope_failure 'compositor KWin ancora attivo o stato non verificabile' 1
                requested=desktop
                return 4
            fi
            if [[ ! -x $gamescope_bin ]]; then
                report_gamescope_failure "wrapper assente: $gamescope_bin" 1
                requested=desktop
                return 4
            fi
            command -v setsid >/dev/null 2>&1 || {
                report_gamescope_failure 'setsid non disponibile' 1
                requested=desktop
                return 4
            }
            clear_kde_environment
            ps5_session_log info "avvio Gamescope via $gamescope_bin"
            rm -f -- "$pgid_file"
            setsid "$supervisor_path" --session-child gamescope 8>&- &
            active_pid=$!
            gamescope_pid=$active_pid
            printf '%s\n' "$active_pid" > "$pgid_file" || {
                terminate_process_group "$active_pid"
                report_gamescope_failure 'impossibile creare il controllo process group' 1
                requested=desktop
                active_pid=''
                return 4
            }
            chmod 0600 "$pgid_file" 2>/dev/null || true
            ;;
    esac
    return 0
}

run_session_manager() {
    local current_target=$requested active_rc switch_target finished_pid tick_pid wait_rc launch_rc session_switched
    local startup_target
    while :; do
        if (( PS5_SESSION_STOP_REQUESTED )) || system_stopping; then
            [[ -z $active_pid ]] || stop_active_session "$current_target" "$active_pid"
            ps5_session_log info 'arresto supervisore durante shutdown'
            return 0
        fi
        startup_target=$current_target
        session_switched=0
        launch_active_session "$current_target"
        launch_rc=$?
        case "$launch_rc" in
            2) ps5_session_log info 'spegnimento durante attesa DRM'; return 0 ;;
            3) current_target=$requested; continue ;;
            4) current_target=$requested; continue ;;
        esac
        active_rc=0
        while :; do
            if (( PS5_SESSION_STOP_REQUESTED )) || system_stopping; then
                stop_active_session "$current_target" "$active_pid"
                active_pid=''
                ps5_session_log info 'arresto sessione grafica durante shutdown'
                return 0
            fi
                        if ps5_session_control_take_request; then
                switch_target=$PS5_SESSION_SWITCH_TARGET
                if [[ $switch_target != "$current_target" ]]; then
                    ps5_session_log info "transizione live richiesta: $current_target -> $switch_target"
                    local stop_rc=0
                    stop_active_session "$current_target" "$active_pid" || stop_rc=$?
                    if (( stop_rc == 3 )) && [[ $current_target == desktop && $switch_target == gamescope ]]; then
                        ps5_session_log warning 'transizione KDE→Gamescope rifiutata: sessione KDE lasciata attiva'
                        requested=desktop
                        continue
                    fi
                    if (( stop_rc != 0 )) && [[ $current_target == desktop && $switch_target == gamescope ]]; then
                        report_gamescope_failure 'KDE non ha rilasciato seat0; transizione annullata' 1
                        requested=desktop
                        current_target=desktop
                        session_switched=1
                        break
                    fi
                    active_pid=''
                    current_target=$switch_target
                    consume_matching_next_session "$switch_target"
                    session_switched=1
                    break
                fi
                ps5_session_log info "richiesta live $switch_target già attiva; nessuna transizione"
                consume_matching_next_session "$switch_target"
            fi
            finished_pid=''
            sleep 0.2 8>&- & tick_pid=$!
            wait -n -p finished_pid "$active_pid" "$tick_pid"
            wait_rc=$?
            if [[ ${finished_pid:-} == "$active_pid" ]]; then
                active_rc=$wait_rc
                wait "$tick_pid" 2>/dev/null || true
                active_pid=''
                break
            fi
            if [[ ${finished_pid:-} == "$tick_pid" ]]; then
                wait "$tick_pid" 2>/dev/null || true
                continue
            fi
            wait "$tick_pid" 2>/dev/null || true
        done
        (( session_switched )) && continue
        [[ -z $active_pid ]] || continue
        if [[ $startup_target == gamescope ]]; then
            cleanup_gamescope
            if (( active_rc == 0 )); then
                report_gamescope_failure 'uscita normale da Gamescope' 0
            else
                report_gamescope_failure "Gamescope exit=$active_rc" 1
            fi
            current_target=desktop
            requested=desktop
            continue
        fi
        ps5_session_log info "KDE terminato (exit=$active_rc); supervisore termina"
        return "$active_rc"
    done
}

if ! ps5_session_control_register; then
    ps5_session_log error 'canale di controllo sessione non disponibile; login TTY1 resta accessibile'
    exit 1
fi
trap 'PS5_SESSION_STOP_REQUESTED=1' TERM INT HUP
trap 'ps5_session_control_unregister' EXIT
run_session_manager
exit $?
