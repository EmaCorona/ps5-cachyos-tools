#!/usr/bin/env bash
set -u
log_file=${PS5_GAMESCOPE_LOG:-${HOME:-/home/steam}/.gamescope.log}
drm_root=${PS5_DRM_SYSFS_ROOT:-/sys/class/drm}
drm_device=${PS5_DRM_DEVICE:-/dev/dri/card0}
config=${PS5_GAMESCOPE_CONFIG:-/etc/ps5-cachyos-tools/gamescope.conf}
steam=${PS5_STEAM_EXEC:-/usr/bin/steam}
gamescope=${PS5_GAMESCOPE_EXEC:-/usr/bin/gamescope}
steam_dir=${PS5_STEAM_DIR:-${HOME:-/home/steam}/.local/share/Steam}
log() { printf '[%s] gamescope-session: %s\n' "$(date -Is 2>/dev/null || date)" "$*" >> "$log_file" 2>/dev/null || true; printf 'gamescope-session: %s\n' "$*" >&2; }
[[ -x "$gamescope" ]] || { log "Gamescope non disponibile: $gamescope"; exit 70; }
[[ -x "$steam" ]] || { log "Steam non disponibile: $steam"; exit 70; }
[[ -e "$drm_device" ]] || { log "device DRM assente: $drm_device"; exit 71; }

# An absent override means that the connected DRM mode remains authoritative.
output_w='' output_h='' nested_w='' nested_h='' refresh=60 output_conn=''
if [[ -e "$config" ]]; then
    [[ -f "$config" && ! -L "$config" ]] || { log "configurazione Gamescope non regolare: $config"; exit 78; }
    declare -A seen=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%%#*}; [[ -z "${line//[[:space:]]/}" ]] && continue
        [[ "$line" =~ ^[[:space:]]*(PS5_[A-Z_]+)=([[:alnum:]_.-]+)[[:space:]]*$ ]] || { log 'riga di configurazione non valida'; exit 78; }
        key=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
        [[ -z ${seen[$key]+x} ]] || { log "chiave duplicata: $key"; exit 78; }; seen[$key]=1
        case "$key" in
            PS5_OUTPUT_WIDTH) output_w=$value;; PS5_OUTPUT_HEIGHT) output_h=$value;;
            PS5_NESTED_WIDTH) nested_w=$value;; PS5_NESTED_HEIGHT) nested_h=$value;;
            PS5_REFRESH_RATE) refresh=$value;; PS5_OUTPUT_CONN) output_conn=$value;;
            *) log "chiave non supportata: $key"; exit 78;;
        esac
    done < "$config"
fi
for value in "${output_w:-1920}" "${output_h:-1080}" "${nested_w:-1920}" "${nested_h:-1080}" "$refresh"; do
    [[ "$value" =~ ^[0-9]{1,5}$ ]] || { log "valore numerico non valido in $config"; exit 78; }
done
(( ${output_w:-1920} >= 320 && ${output_w:-1920} <= 7680 && ${output_h:-1080} >= 200 && ${output_h:-1080} <= 4320 && ${nested_w:-1920} >= 320 && ${nested_w:-1920} <= 7680 && ${nested_h:-1080} >= 200 && ${nested_h:-1080} <= 4320 && refresh >= 24 && refresh <= 240 )) || { log 'modalità configurata fuori dai limiti'; exit 78; }
[[ -z "$output_conn" || "$output_conn" =~ ^[A-Za-z0-9_-]+$ ]] || { log 'connettore non valido'; exit 78; }
detected_conn='' detected_w='' detected_h=''
for connector in "$drm_root"/card*-*; do
    [[ -r "$connector/status" && $(<"$connector/status") == connected && -r "$connector/modes" ]] || continue
    mode=''; IFS= read -r mode < "$connector/modes" || true
    [[ "$mode" =~ ^([0-9]{3,5})x([0-9]{3,5})$ ]] || continue
    detected_conn=${connector##*/}; detected_conn=${detected_conn#card*-}
    detected_w=${BASH_REMATCH[1]} detected_h=${BASH_REMATCH[2]}
    case "$detected_conn" in DP-1|HDMI-A-1) break;; esac
done
if [[ -z "$detected_w" ]]; then
    [[ ${PS5_SKIP_DRM_CHECK:-0} == 1 ]] || { log 'nessun connettore DRM connected con una mode valida'; exit 71; }
    detected_w=1920 detected_h=1080
fi
output_w=${output_w:-$detected_w}; output_h=${output_h:-$detected_h}
nested_w=${nested_w:-$output_w}; nested_h=${nested_h:-$output_h}
output_conn=${output_conn:-${detected_conn:-DP-1,HDMI-A-1}}
log "output=$output_conn ${output_w}x${output_h} nested=${nested_w}x${nested_h} refresh=$refresh"
[[ -x /usr/local/bin/ps5-cachyos-tools-steam-verify-repair ]] && /usr/local/bin/ps5-cachyos-tools-steam-verify-repair "$steam_dir" >> "$log_file" 2>&1 || true
export LIBSEAT_BACKEND=logind STEAM_ENABLE_DECK_UI=1 GAMESCOPE_FORCE_GRAB_CURSOR=1
export XDG_CURRENT_DESKTOP=gamescope XDG_SESSION_TYPE=wayland WLR_DRM_DEVICES="$drm_device"
export GAMESCOPE_DISPLAY_SUPPORTS_HDR=0 GAMESCOPE_DISPLAY_HDR_ENABLED=0 GAMESCOPE_COLOR_MANAGEMENT_DISABLE=1 STEAM_GAMESCOPE_HDR_SUPPORTED=0 DXVK_HDR=0
export RADV_DEBUG=${RADV_DEBUG:-nodcc} WLR_DRM_NO_MODIFIERS=1 GAMESCOPE_COMPOSITE_FORCE=1
stats_path=${PS5_STATS_PATH:-/run/user/$(id -u)/gamescope-stats.json}
[[ -d "${stats_path%/*}" ]] || stats_path="${TMPDIR:-/tmp}/gamescope-stats.json"
args=(-W "$output_w" -H "$output_h" -w "$nested_w" -h "$nested_h" -r "$refresh" --backend drm --prefer-output "$output_conn" --force-composition --disable-layers --disable-color-management --sdr-gamut-wideness 0 --force-grab-cursor --stats-path "$stats_path" -e)
console_log="$steam_dir/logs/console-linux.txt"
console_offset=0; [[ -f "$console_log" ]] && console_offset=$(wc -c < "$console_log" 2>/dev/null || echo 0)
log_offset=0; [[ -f "$log_file" ]] && log_offset=$(wc -c < "$log_file" 2>/dev/null || echo 0)
log 'avvio del wrapper DRM con Steam in modalità gamepad'
"$gamescope" "${args[@]}" -- "$steam" -gamepadui -steamos >> "$log_file" 2>&1
rc=$?
if { [[ -f "$console_log" ]] && tail -c +$((console_offset + 1)) "$console_log" 2>/dev/null | grep -Eqi 'Bus error|Segmentation fault|core dumped|crash_[0-9]'; } || \
   tail -c +$((log_offset + 1)) "$log_file" 2>/dev/null | grep -Eqi 'Bus error|Segmentation fault|core dumped|crash_[0-9]'; then
    log 'rilevato crash Steam nel log console'; exit 73
fi
log "Gamescope terminato con exit=$rc"
exit "$rc"
