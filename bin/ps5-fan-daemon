#!/usr/bin/env bash
set -u

BASE=${PS5_FAN_CONFIG_DIR:-/etc/ps5-fan}; CONF=${PS5_FAN_CONFIG:-$BASE/fan.conf}
PROFILE=balanced; TARGET_FILE=/sys/bus/platform/devices/ps5-fan/target_temp; HWMON_BASE=/sys/class/hwmon
STATE_FILE=${PS5_FAN_STATE_FILE:-/run/ps5-fan/runtime.state}
SENSOR_FAILURE_LIMIT=
POLL_INTERVAL=2; HYSTERESIS=2; SLEW_COOL_STEP=2; RECOVERY_VALID_SAMPLES=2; EMERGENCY_TEMP=81; EMERGENCY_RECOVERY_DELTA=3; DEGRADED_TARGET=40; ENABLE_PWM=0
valid_uint(){ [[ ${1:-} =~ ^[0-9]+$ ]] && { local n=${1#${1%%[!0]*}}; [ -n "$n" ] || n=0; [ "${#n}" -le 9 ]; }; }
normalize_uint(){ local n=${1#${1%%[!0]*}}; [ -n "$n" ] || n=0; printf '%s' "$n"; }
validate_uint(){ local name=$1 min=$2 max=$3 n; n=$(normalize_uint "${!name:-}"); valid_uint "$n" && [ "$n" -ge "$min" ] && [ "$n" -le "$max" ] || return 1; printf -v "$name" '%s' "$n"; }
publish_config_error(){ local code=$1 dir tmp; dir=$(dirname "$STATE_FILE"); mkdir -p "$dir" 2>/dev/null || return 1; tmp=$(mktemp "${STATE_FILE}.XXXXXX") 2>/dev/null || return 1; printf 'profile_configured=%s\nprofile_applied=unknown\nstate=UNAVAILABLE\ntemperature=unknown\nsensor_name=none\nsensor_label=none\nsensor_path=none\ntarget_desired=-1\ntarget_observed=-1\ntarget_last_verified=-1\ntarget_verified=-1\nzone=unknown\nlast_write=failed\nlast_error=config-invalid\nlast_runtime_error=none\nlast_config_error=%s\nlast_event=config-invalid\ncycles=0\ninstance_id=none\nupdated_at=%s\n' "$PROFILE" "$code" "$(date +%s)" > "$tmp" && mv -f "$tmp" "$STATE_FILE"; }
log_event(){ printf 'ps5-fan: %s\n' "$*" >&2; }
load_kv(){ local file=$1 line key value; [ -r "$file" ] || return 0; while IFS= read -r line || [ -n "$line" ]; do [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue; [[ "$line" =~ ^([A-Z_]+)=(.*)$ ]] || return 1; key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}; value=${value%\"}; value=${value#\"}; case "$key" in PROFILE|TARGET_FILE|HWMON_BASE|POLL_INTERVAL|HYSTERESIS|SLEW_COOL_STEP|COOLDOWN_SEC|RECOVERY_VALID_SAMPLES|EMERGENCY_TEMP|EMERGENCY_RECOVERY_DELTA|DEGRADED_TARGET|ENABLE_PWM|ZONE_TEMPS|ZONE_TARGETS|SENSOR_FAILURE_LIMIT) printf -v "$key" '%s' "$value";; *) return 1;; esac; done < "$file"; }
load_profile(){ local file=$1 line key value declared=; ZONE_TEMPS=; ZONE_TARGETS=; HYSTERESIS=2; SLEW_COOL_STEP=2; COOLDOWN_SEC=0; POLL_INTERVAL=2; while IFS= read -r line || [ -n "$line" ]; do [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue; [[ "$line" =~ ^([A-Z_]+)=(.*)$ ]] || return 1; key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}; value=${value%\"}; value=${value#\"}; case "$key" in PROFILE) declared=$value;; ZONE_TEMPS|ZONE_TARGETS|HYSTERESIS|SLEW_COOL_STEP|COOLDOWN_SEC|POLL_INTERVAL) printf -v "$key" '%s' "$value";; *) return 1;; esac; done < "$file"; [ "$declared" = "$PROFILE" ] || return 1; local -a ts=($ZONE_TEMPS) vs=($ZONE_TARGETS); [ "${#ts[@]}" -eq 15 ] && [ "${#vs[@]}" -eq 15 ] || return 1; local i; for ((i=0;i<15;i++)); do valid_uint "${ts[i]}" && valid_uint "${vs[i]}" || return 1; ts[i]=$(normalize_uint "${ts[i]}"); vs[i]=$(normalize_uint "${vs[i]}"); [ "${ts[i]}" -ge 10 ] && [ "${ts[i]}" -le 120 ] && [ "${vs[i]}" -ge 28 ] && [ "${vs[i]}" -le 78 ] || return 1; [ "$i" -eq 0 ] || [ "${ts[i]}" -gt "${ts[i-1]}" ] || return 1; [ "$i" -eq 0 ] || [ "${vs[i]}" -le "${vs[i-1]}" ] || return 1; done; ZONE_TEMPS="${ts[*]}"; ZONE_TARGETS="${vs[*]}"; validate_uint HYSTERESIS 0 30 && validate_uint SLEW_COOL_STEP 1 50 && validate_uint COOLDOWN_SEC 0 3600 && validate_uint POLL_INTERVAL 1 60; }
load_kv "$CONF" || { echo 'fan: configurazione non valida' >&2; publish_config_error config-parse-failed; exit 2; }
if [ -n "$SENSOR_FAILURE_LIMIT" ]; then valid_uint "$SENSOR_FAILURE_LIMIT" || { echo 'fan: SENSOR_FAILURE_LIMIT legacy non numerico' >&2; publish_config_error legacy-config-invalid; exit 2; }; log_event 'avviso: SENSOR_FAILURE_LIMIT è deprecato e non modifica la politica DEGRADED'; fi
validate_uint POLL_INTERVAL 1 60 && validate_uint HYSTERESIS 0 30 && validate_uint SLEW_COOL_STEP 1 50 && validate_uint RECOVERY_VALID_SAMPLES 2 10 && validate_uint EMERGENCY_TEMP 80 81 && validate_uint EMERGENCY_RECOVERY_DELTA 1 20 && validate_uint DEGRADED_TARGET 28 78 && validate_uint ENABLE_PWM 0 0 || { echo 'fan: parametro fuori range o PWM non supportato' >&2; publish_config_error config-range-failed; exit 2; }
EMERGENCY_EXIT_TEMP=$((EMERGENCY_TEMP-EMERGENCY_RECOVERY_DELTA)); [ "$EMERGENCY_EXIT_TEMP" -ge 70 ] || { echo 'fan: soglia di uscita EMERGENCY pericolosa' >&2; publish_config_error emergency-recovery-invalid; exit 2; }
[ -n "$TARGET_FILE" ] && [ -n "$HWMON_BASE" ] && [ "$ENABLE_PWM" = 0 ] || { echo 'fan: configurazione hardware non valida' >&2; publish_config_error hardware-config-invalid; exit 2; }
case "$PROFILE" in low|balanced|high) ;; *) echo 'fan: profilo configurato non valido' >&2; publish_config_error profile-config-invalid; exit 2;; esac
[ -r "$BASE/state" ] || { echo 'fan: stato profilo assente o non leggibile' >&2; publish_config_error profile-state-missing; exit 2; }
[ -n "${PS5_FAN_TARGET_FILE:-$TARGET_FILE}" ] && [ -n "${PS5_FAN_HWMON_BASE:-$HWMON_BASE}" ] || { echo 'fan: override hardware vuoto' >&2; publish_config_error hardware-override-invalid; exit 2; }
TARGET_FILE=${PS5_FAN_TARGET_FILE:-$TARGET_FILE}; HWMON_BASE=${PS5_FAN_HWMON_BASE:-$HWMON_BASE}
PROFILE_FILE="$BASE/profiles/$PROFILE.conf"; [ -r "$PROFILE_FILE" ] && load_profile "$PROFILE_FILE" || { echo "fan: profilo non valido: $PROFILE" >&2; publish_config_error profile-file-invalid; exit 2; }
if [ "${PS5_FAN_POLL_SEC+x}" = x ]; then POLL_INTERVAL=$PS5_FAN_POLL_SEC; fi; MAX_CYCLES=${PS5_FAN_MAX_CYCLES:-0}; validate_uint POLL_INTERVAL 1 60 && validate_uint MAX_CYCLES 0 999999999 || { echo 'fan: override numerico fuori range' >&2; publish_config_error runtime-override-invalid; exit 2; }
LOCK_FILE=${PS5_FAN_LOCK_FILE:-/run/ps5-fan/daemon.lock}; mkdir -p "$(dirname "$STATE_FILE")" 2>/dev/null || exit 1; mkdir -p "$(dirname "$LOCK_FILE")" 2>/dev/null || { LOCK_FILE=$BASE/daemon.lock; mkdir -p "$BASE" || exit 1; }
exec 9>"$LOCK_FILE" || exit 1; flock -n 9 || { echo 'fan: altra istanza già attiva' >&2; exit 3; }

now(){ date +%s; }
TEMP_VALUE=-1; SENSOR_NAME=none; SENSOR_LABEL=none; SENSOR_PATH=none; SENSOR_KEY=none
read_apu_sensor(){ local f v n name label key rank best_rank=99 best_path= best_n best_name best_label best_key; TEMP_VALUE=-1; SENSOR_NAME=none; SENSOR_LABEL=none; SENSOR_PATH=none; SENSOR_KEY=none; for f in "$HWMON_BASE"/hwmon*/temp*_input; do [ -r "$f" ] || continue; v=$(<"$f") || continue; valid_uint "$v" || continue; n=$(normalize_uint "$v"); [ "$n" -gt 1000 ] && n=$((n/1000)); [ "$n" -ge 10 ] && [ "$n" -le 120 ] || continue; name=; label=; [ -r "$(dirname "$f")/name" ] && name=$(<"$(dirname "$f")/name"); [ -r "${f%_input}_label" ] && label=$(<"${f%_input}_label"); key="$name|$label"; [[ "$name" =~ ^(nvme|drivetemp|acpitz)$ ]] && continue; rank=99; [[ "$name" == ps5 ]] && rank=0; [[ "$name" == ps5_thermal ]] && rank=1; [[ "$name" == k10temp ]] && rank=2; [[ "$name" == zenpower ]] && rank=3; if [ "$rank" -eq 99 ] && [[ "$label" =~ ^(Tctl|Tdie|APU|CPU[[:space:]]Package)$ ]]; then rank=4; fi; [ "$rank" -lt 99 ] || continue; if [ "$rank" -lt "$best_rank" ] || { [ "$rank" -eq "$best_rank" ] && { [ -z "$best_path" ] || [[ "$f" < "$best_path" ]]; }; }; then best_rank=$rank; best_path=$f; best_n=$n; best_name=$name; best_label=$label; best_key=$key; fi; done; [ "$best_rank" -lt 99 ] || return 1; TEMP_VALUE=$best_n; SENSOR_NAME=${best_name:-unknown}; SENSOR_LABEL=${best_label:-unknown}; SENSOR_PATH=$best_path; SENSOR_KEY=$best_key; return 0; }
target_for(){ local t=$1 i prev_t=0 prev_v; local -a ts=($ZONE_TEMPS) vs=($ZONE_TARGETS); prev_v=${vs[0]}; [ "$t" -le "${ts[0]}" ] && { echo "$prev_v"; return; }; for ((i=0;i<${#ts[@]};i++)); do [ "$t" -le "${ts[i]}" ] && { local span=$((ts[i]-prev_t)) drop=$((prev_v-vs[i])) step=$((t-prev_t)); echo $((prev_v - (drop*step + span/2)/span)); return; }; prev_t=${ts[i]}; prev_v=${vs[i]}; done; [ "$t" -le "$EMERGENCY_TEMP" ] && echo 29 || echo 28; }
zone_for(){ local t=$1 i; valid_uint "$t" && [ "$t" -ge 10 ] && [ "$t" -le 120 ] || { echo unknown; return; }; local -a ts=($ZONE_TEMPS); for ((i=0;i<${#ts[@]};i++)); do [ "$t" -le "${ts[i]}" ] && { echo $((i+1)); return; }; done; echo 15; }
read_target(){ [ -r "$TARGET_FILE" ] && { local v; v=$(<"$TARGET_FILE"); valid_uint "$v" && [ "$v" -ge 28 ] && [ "$v" -le 78 ] && echo "$(normalize_uint "$v")" && return; }; echo -1; }
write_target(){ local wanted=$1; WRITE_OBSERVED=-1; [ "$wanted" -ge 28 ] && [ "$wanted" -le 78 ] || return 2; [ -w "$TARGET_FILE" ] || return 1; printf '%s\n' "$wanted" > "$TARGET_FILE" || return 1; WRITE_OBSERVED=$(read_target); [ "$WRITE_OBSERVED" = "$wanted" ]; }
write_state(){ local state=$1 temp=$2 desired=$3 observed=$4 verified=$5 zone=$6 cooldown=$7 err=$8 tmp; tmp=$(mktemp "${STATE_FILE}.XXXXXX") || return 1; printf 'profile_configured=%s\nprofile_applied=%s\nstate=%s\ntemperature=%s\nsensor_name=%s\nsensor_label=%s\nsensor_path=%s\ntarget_desired=%s\ntarget_observed=%s\ntarget_last_verified=%s\ntarget_verified=%s\nzone=%s\ncooldown_until=%s\nlast_write=%s\nlast_error=%s\nlast_runtime_error=%s\nlast_config_error=%s\nlast_event=%s\ncycles=%s\ninstance_id=%s\nupdated_at=%s\n' "$PROFILE_CONFIGURED" "$PROFILE" "$state" "$temp" "$SENSOR_NAME" "$SENSOR_LABEL" "$SENSOR_PATH" "$desired" "$observed" "$verified" "$observed" "$zone" "$cooldown" "$([ "$err" = none ] && echo success || echo failed)" "$err" "$runtime_error" "$config_error" "$last_event" "$cycles" "$INSTANCE_ID" "$(now)" > "$tmp" && mv -f "$tmp" "$STATE_FILE"; }
reload_profile(){ local selected=$1 file="$BASE/profiles/$1.conf" old_profile=$PROFILE old_temps=${ZONE_TEMPS-} old_targets=${ZONE_TARGETS-} old_hyst=$HYSTERESIS old_slew=$SLEW_COOL_STEP old_cool=$COOLDOWN_SEC old_poll=$POLL_INTERVAL; case "$selected" in low|balanced|high) ;; *) return 1;; esac; [ -r "$file" ] || return 1; PROFILE=$selected; if load_profile "$file"; then return 0; fi; PROFILE=$old_profile; ZONE_TEMPS=$old_temps; ZONE_TARGETS=$old_targets; HYSTERESIS=$old_hyst; SLEW_COOL_STEP=$old_slew; COOLDOWN_SEC=$old_cool; POLL_INTERVAL=$old_poll; return 1; }
main(){
    local current=-1 raw desired=-1 state=NORMAL failures=0 recovery_streak=0 emergency_streak=0 last_temp=-1 cooldown_until=0 last_error=none last_logged_error=none runtime_error=none config_error=none last_event=started cycles=0 PROFILE_CONFIGURED=$PROFILE last_verified=-1 observed=-1 profile_attempted='' profile_signature=''
    local cycles=0 INSTANCE_ID=${PS5_FAN_INSTANCE_ID:-$(printf '%s-%s' "$$" "$(date +%s%N)")}
    while :; do
        cycles=$((cycles+1)); local selected=$PROFILE_CONFIGURED state_before=$state error_before=$last_error
        selected=__missing__; [ -r "$BASE/state" ] && selected=$(<"$BASE/state")
        local selected_file="$BASE/profiles/$selected.conf" selected_signature='missing' profile_changed=0
        [ -r "$selected_file" ] && selected_signature=$(cksum "$selected_file")
        [ "$selected" != "$profile_attempted" ] && profile_changed=1
        [ "$config_error" = none ] && [ "$selected" != "$PROFILE" ] && profile_changed=1
        [ "$config_error" != none ] && [ "$selected_signature" != "$profile_signature" ] && profile_changed=1
        if [ "$profile_changed" -eq 1 ]; then
            profile_attempted=$selected; profile_signature=$selected_signature
            if reload_profile "$selected"; then
                if [ "$config_error" != none ]; then log_event "profilo recuperato: $selected"; last_event=profile-recovered; else log_event "profilo applicato: $selected"; last_event=profile-applied; fi
                PROFILE_CONFIGURED=$selected; config_error=none
            else config_error=invalid-profile; last_event=invalid-profile; log_event "profilo rifiutato: $selected"; fi
        fi

        if read_apu_sensor; then raw=$TEMP_VALUE; else raw=-1; fi
        observed=$(read_target)
        local hardware_ok=0 sensor_ok=0
        [ "$observed" -ge 0 ] && hardware_ok=1 && last_verified=$observed && current=$observed
        [ "$raw" -ge 0 ] && sensor_ok=1
        desired=-1

        if [ "$sensor_ok" -eq 0 ] || [ "$hardware_ok" -eq 0 ]; then
            state=DEGRADED; recovery_streak=0; emergency_streak=0
            runtime_error=$([ "$sensor_ok" -eq 0 ] && echo sensor-unavailable || echo target-readback-failed)
            if [ "$hardware_ok" -eq 1 ]; then
                desired=$DEGRADED_TARGET
                [ "$desired" -gt "$observed" ] && desired=$observed
            elif [ "$last_verified" -ge 0 ]; then
                desired=$DEGRADED_TARGET
                [ "$desired" -gt "$last_verified" ] && desired=$last_verified
            fi
        elif [ "$raw" -ge "$((EMERGENCY_TEMP+1))" ]; then
            state=EMERGENCY; recovery_streak=0; emergency_streak=0; desired=28; runtime_error=none
        elif [ "$raw" -ge "$EMERGENCY_TEMP" ]; then
            state=EMERGENCY; recovery_streak=0; emergency_streak=0; desired=29; runtime_error=none
            [ "$current" -eq 28 ] && desired=28
        elif [ "$state" = EMERGENCY ]; then
            recovery_streak=0; desired=29; runtime_error=none
            [ "$raw" -le "$EMERGENCY_EXIT_TEMP" ] && emergency_streak=$((emergency_streak+1)) || emergency_streak=0
            [ "$current" -eq 28 ] && desired=28
            if [ "$raw" -le "$EMERGENCY_EXIT_TEMP" ] && [ "$emergency_streak" -ge "$RECOVERY_VALID_SAMPLES" ]; then
                state=NORMAL; emergency_streak=0; desired=$(target_for "$raw")
            fi
        elif [ "$state" = DEGRADED ]; then
            recovery_streak=$((recovery_streak+1)); emergency_streak=0; desired=$DEGRADED_TARGET; runtime_error=none
            [ "$desired" -gt "$observed" ] && desired=$observed
            if [ "$recovery_streak" -ge "$RECOVERY_VALID_SAMPLES" ]; then
                state=NORMAL; desired=$(target_for "$raw")
            fi
        else
            recovery_streak=0; emergency_streak=0; runtime_error=none
            [ "$last_temp" -ge 0 ] && [ "$raw" -gt $((last_temp+HYSTERESIS)) ] && state=HEATING
            [ "$state" = HEATING ] && [ "$raw" -le "$last_temp" ] && state=NORMAL
            if [ "$last_temp" -ge 0 ] && [ "$raw" -lt "$last_temp" ] && [ $((last_temp-raw)) -lt "$HYSTERESIS" ]; then desired=$current; else desired=$(target_for "$raw"); fi
            if [ "$last_temp" -ge 70 ] && [ "$raw" -lt "$last_temp" ] && [ "$COOLDOWN_SEC" -gt 0 ] && [ "$cooldown_until" -le "$(now)" ]; then cooldown_until=$(( $(now)+COOLDOWN_SEC )); fi
        fi

        if [ "$desired" -ge 0 ] && [ "$desired" != "$current" ] && [ "$hardware_ok" -eq 1 ]; then
            if [ "$state" != EMERGENCY ] && [ "$desired" -gt "$current" ] && [ "$desired" -gt $((current+SLEW_COOL_STEP)) ]; then desired=$((current+SLEW_COOL_STEP)); fi
            [ "$cooldown_until" -gt "$(now)" ] && [ "$desired" -gt "$current" ] && desired=$current
            if [ "$desired" != "$current" ]; then
                if write_target "$desired"; then observed=$WRITE_OBSERVED; [ "$observed" -ge 0 ] && current=$observed && last_verified=$observed && runtime_error=none || { state=DEGRADED; recovery_streak=0; runtime_error=write-readback-unverified; }; else observed=$WRITE_OBSERVED; state=DEGRADED; recovery_streak=0; runtime_error=write-or-readback-failed; fi
            fi
        fi
        [ "$raw" -ge 0 ] && last_temp=$raw
        [ "$state" != "$state_before" ] && last_event="state-$state_before-to-$state" && log_event "stato: $state_before -> $state"
        last_error=$([ "$config_error" != none ] && echo "$config_error" || echo "$runtime_error")
        [ "$last_error" != none ] && [ "$last_error" != "$last_logged_error" ] && log_event "errore: $last_error"
        last_logged_error=$last_error
        write_state "$state" "${raw:-unknown}" "$desired" "$observed" "$last_verified" "$(zone_for "${raw#-}")" "$cooldown_until" "$last_error" || last_error=runtime-state-write-failed
        [ "${1:-}" = --once ] && return; [ "$MAX_CYCLES" -gt 0 ] && [ "$cycles" -ge "$MAX_CYCLES" ] && return; sleep "$POLL_INTERVAL"
    done
}
if [ "${PS5_FAN_LIB_ONLY:-0}" != 1 ]; then main "$@"; fi
