#!/usr/bin/env bash
set -u
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -f "$SCRIPT_DIR/../lib/core/log.sh" ]; then BASE=$(cd "$SCRIPT_DIR/.." && pwd); else
    BASE=${PS5_TOOLS_RUNTIME_BASE:-/usr/lib/ps5-cachyos-tools}
    case "$SCRIPT_DIR" in
        */usr/local/bin)
            candidate=${SCRIPT_DIR%/usr/local/bin}
            [ -n "$candidate" ] && [ "$candidate" != / ] && [ -d "$candidate/usr/lib/ps5-cachyos-tools" ] && BASE="$candidate/usr/lib/ps5-cachyos-tools"
            ;;
    esac
fi
source "$BASE/lib/core/log.sh" 2>/dev/null || source "$BASE/core/log.sh"; source "$BASE/lib/core/target.sh" 2>/dev/null || source "$BASE/core/target.sh"; source "$BASE/lib/core/registry.sh" 2>/dev/null || source "$BASE/core/registry.sh"; source "$BASE/lib/core/dependencies.sh" 2>/dev/null || source "$BASE/core/dependencies.sh"; source "$BASE/lib/core/state.sh" 2>/dev/null || source "$BASE/core/state.sh"; source "$BASE/lib/core/installer.sh" 2>/dev/null || source "$BASE/core/installer.sh"; source "$BASE/lib/core/service.sh" 2>/dev/null || source "$BASE/core/service.sh"
usage() { printf '%s\n' 'uso: ps5-cachyos-tools list | install (--root ROOT [--boot BOOT]|--live) [--module ID] [--dry-run] [--no-start] | check (--root ROOT|--live) | status [--root ROOT|--live] | reset ID --root ROOT | reapply ID [--root ROOT|--live] | remove --module ID --root ROOT [--keep-config|--purge-config]'; }
need_arg() { [ "$#" -ge 2 ] && [ -n "$2" ] && { printf '%s\n' "$2"; return 0; }; core_die "valore mancante per $1"; return 2; }
core_cli_status() {
    local root=$1 id f installed enabled type policy active readiness runtime_state state profile
    [ -d "$root/var/lib/ps5-cachyos-tools/state/modules" ] || return 1
    core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null 2>&1 || true
    for id in "${CORE_MODULE_IDS[@]}"; do
        f="$root/var/lib/ps5-cachyos-tools/state/modules/$id.state"
        installed=no; [ -f "$root/usr/lib/ps5-cachyos-tools/modules/$id/module.conf" ] && installed=yes
        enabled=$(core_registry_field "$id" 1 2>/dev/null || echo unknown)
        type=$(core_registry_field "$id" 2 2>/dev/null || echo unknown)
        policy=$(core_registry_field "$id" 3 2>/dev/null || echo unknown)
        active=offline; readiness=not-checked
        if [ "$root" = / ] && [ "$type" = service ]; then
            if systemctl is-active --quiet "$(core_registry_field "$id" 7)" 2>/dev/null; then active=yes; else active=no; fi
            if [ "$active" = yes ] && [ "$id" = fan ] && [ -r /run/ps5-fan/runtime.state ]; then
                runtime_state=$(awk -F= '$1=="state"{print $2; exit}' /run/ps5-fan/runtime.state 2>/dev/null || true)
                profile=$(awk -F= '$1=="profile_applied"{print $2; exit}' /run/ps5-fan/runtime.state 2>/dev/null || true)
                case "$runtime_state:$profile" in
                    NORMAL:*|HEATING:*|EMERGENCY:*) readiness=ready ;;
                    DEGRADED:*) readiness=degraded ;;
                    *) readiness=not-ready ;;
                esac
            elif [ "$active" = no ]; then readiness=not-running; fi
        fi
        printf '%s: installed=%s enabled=%s type=%s policy=%s present=yes active=%s readiness=%s ' "$id" "$installed" "$enabled" "$type" "$policy" "$active" "$readiness"
        [ -f "$f" ] && awk -F= '$1=="status"||$1=="last_attempt_at"||$1=="completed_at"||$1=="last_boot_id"||$1=="reapply_requested"{printf "%s=%s ",$1,$2}' "$f"
        [ -f "$root/var/lib/ps5-cachyos-tools/state/reapply/$id.request" ] && printf 'reapply_requested=true '
        printf '\n'
    done
}
main() {
    local cmd=${1-} root='' boot='' module='' live=0 dry=0 no_start=0 keep_config=1; shift || true
    if [[ "$cmd" = reset || "$cmd" = reapply || "$cmd" = remove ]] && [ "$#" -gt 0 ] && [[ "$1" != --* ]]; then module=$1; shift; fi
    while [ "$#" -gt 0 ]; do case "$1" in --root) root=$(need_arg "$1" "${2-}") || return $?; shift 2;; --boot) boot=$(need_arg "$1" "${2-}") || return $?; shift 2;; --live) live=1; shift;; --module) module=$(need_arg "$1" "${2-}") || return $?; shift 2;; --dry-run) dry=1; shift;; --no-start) no_start=1; shift;; --keep-config) keep_config=1; shift;; --purge-config) keep_config=0; shift;; --force|--all) core_die "$1 richiede un comando esplicito: usare reapply o --module"; return 2;; --help|-h) usage; return 0;; *) core_die "opzione sconosciuta: $1"; return 2;; esac; done
    CORE_KEEP_CONFIG=$keep_config; export CORE_KEEP_CONFIG
    if [ "$cmd" = reset ]; then
        [[ "$module" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { core_die 'ID modulo non valido'; return 2; }
        if [ "$live" -eq 1 ]; then
            [ -z "$root" ] || { core_die '--live e --root sono incompatibili'; return 2; }
            root=$(core_target_validate_live) || return 1
        else
            [ -n "$root" ] || { core_die '--root richiesto'; return 2; }
            root=$(core_target_validate_offline "$root") || return 1
        fi
        core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null || return 1
        [ "${CORE_MODULE[$module]+x}" = x ] || { core_die "modulo inesistente: $module"; return 1; }
    fi
    if [ "$cmd" = status ] && [ -n "$root" ]; then
        root=$(core_target_validate_offline "$root") || return 1
        core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null || return 1
    fi
    if [ "$cmd" = status ]; then
        root=${root:-/}
        core_cli_status "$root"
        return $?
    fi
    case "$cmd" in
        list) core_registry_discover "$BASE/modules"; core_registry_validate_dependencies;;
        install) if [ "$live" -eq 1 ]; then [ -z "$root" ] || { core_die '--live e --root sono incompatibili'; return 2; }; root=$(core_target_validate_live) || return 1; else [ -n "$root" ] || { core_die '--root richiesto in modalità offline'; return 2; }; root=$(core_target_validate_offline "$root" "$boot") || return 1; [ -z "$boot" ] || boot=$(core_target_boot_path "$root" "$boot") || { core_die 'partizione boot non valida'; return 1; }; fi; [ "$dry" -eq 0 ] || { core_registry_discover "$BASE/modules" >/dev/null || return 1; CORE_BOOT_TARGET=$boot core_install_preflight "$root" "$BASE" "$module" || return 1; order=$(core_registry_selection_order "$module") || return 1; core_log "dry-run: target=$root module=${module:-all} boot=${boot:-none}"; while IFS= read -r id; do [ -n "$id" ] || continue; core_log "dry-run: selezionato=$id operazione=install preserve-config=true artifacts=$(core_registry_field "$id" 10)"; done <<< "$order"; return 0; }; PS5_TOOLS_NO_START=$no_start CORE_CONFIG_ROOT=$root CORE_BOOT_TARGET=$boot CORE_INSTALL_MODE=$([ "$live" -eq 1 ] && echo live || echo offline) core_install "$root" "$BASE" "$module" || return 1;;
        check) if [ "$live" -eq 1 ]; then [ -z "$root" ] || { core_die '--live e --root sono incompatibili'; return 2; }; root=$(core_target_validate_live) || return 1; else [ -n "$root" ] || { core_die '--root richiesto'; return 2; }; root=$(core_target_validate_offline "$root") || return 1; fi; core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null || return 1; for id in "${CORE_MODULE_IDS[@]}"; do if [ -x "$root/usr/lib/ps5-cachyos-tools/modules/$id/check.sh" ]; then "$root/usr/lib/ps5-cachyos-tools/modules/$id/check.sh" "$root" || return 1; fi; done;;
        reset) [[ "$module" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { core_die 'ID modulo non valido'; return 2; }; if [ "$live" -eq 1 ]; then root=$(core_target_validate_live) || return 1; else root=$(core_target_validate_offline "$root") || return 1; fi; core_txn_lock "$root" || return 1; state="$root/var/lib/ps5-cachyos-tools/state/modules/$module.state"; reset_backup=$(mktemp "$root/var/lib/ps5-cachyos-tools/state/modules/.reset.XXXXXX") || return 1; if [ -f "$state" ]; then cp -a -- "$state" "$reset_backup" || return 1; fi; if ! rm -f -- "$state"; then [ ! -f "$reset_backup" ] || cp -a -- "$reset_backup" "$state"; rm -f -- "$reset_backup"; return 1; fi; rm -f -- "$reset_backup";;
        remove) [ -n "$module" ] || { core_die '--module richiesto'; return 2; }; if [ "$live" -eq 1 ]; then root=$(core_target_validate_live) || return 1; else root=$(core_target_validate_offline "$root") || return 1; fi; core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null || return 1; core_registry_validate_dependencies || return 1; [ "${CORE_MODULE[$module]+x}" = x ] || { core_die "modulo inesistente: $module"; return 1; }; for id in "${CORE_MODULE_IDS[@]}"; do [ "$id" = "$module" ] && continue; for dep in $(core_registry_field "$id" 6); do [ "$dep" != "$module" ] || { core_die "rimozione bloccata: $id dipende da $module"; return 1; }; done; done; backup=$(mktemp -d "$root/.ps5-cachyos-tools-remove.XXXXXX") || return 1; core_remove_snapshot "$root" "$module" "$backup" || { core_log "snapshot remove fallito: $backup"; return 1; }; service_type=$(core_registry_field "$module" 2); [ "$service_type" != service ] || core_service_snapshot_state "$root" "$module"; if [ "$service_type" = service ] && ! core_service_stop "$root" "$module"; then core_remove_restore "$root" "$backup" || true; core_service_restore_state "$root" "$module" || core_log "ROLLBACK_FAILED: service=$module backup=$backup"; core_log "rimozione annullata; backup conservato: $backup"; return 1; fi; hook="$root/usr/lib/ps5-cachyos-tools/modules/$module/remove.sh"; remove_rc=0; if [ -x "$hook" ]; then CORE_INSTALL_MODE=$([ "$live" -eq 1 ] && echo live || echo offline) CORE_TARGET_ROOT="$root" CORE_MODULE_ID="$module" "$hook" "$root" "$keep_config" || remove_rc=$?; else [ "$service_type" != service ] || core_service_module_remove "$root" "$module" || remove_rc=$?; fi; [ "$remove_rc" -eq 0 ] && core_remove_module_artifacts "$root" "$module" || remove_rc=$?; if [ "$remove_rc" -eq 0 ]; then rm -rf -- "$root/usr/lib/ps5-cachyos-tools/modules/$module" "$root/var/lib/ps5-cachyos-tools/state/modules/$module.state" || remove_rc=$?; [ "$remove_rc" -eq 0 ] && { [ ! -e "$root/usr/lib/ps5-cachyos-tools/modules/$module" ] && [ ! -e "$root/var/lib/ps5-cachyos-tools/state/modules/$module.state" ]; } || remove_rc=1; fi; if [ "$remove_rc" -eq 0 ]; then rm -rf -- "$backup"; else core_remove_restore "$root" "$backup" || core_log "ROLLBACK_FAILED: remove backup=$backup"; core_service_restore_state "$root" "$module" || core_log "ROLLBACK_FILES_RESTORED_SERVICE_FAILED: service=$module"; core_log "rimozione fallita; backup conservato: $backup"; return "${remove_rc:-1}"; fi;;
        reapply) [ -n "$module" ] || { core_die 'ID modulo richiesto'; return 2; }; if [ "$live" -eq 1 ]; then [ -z "$root" ] || { core_die '--live e --root sono incompatibili'; return 2; }; root=$(core_target_validate_live) || return 1; else [ -n "$root" ] || { core_die '--root richiesto'; return 2; }; root=$(core_target_validate_offline "$root") || return 1; fi; core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null || return 1; [ "${CORE_MODULE[$module]+x}" = x ] || { core_die "modulo inesistente: $module"; return 1; }; phase=$(core_registry_field "$module" 4); [ "$phase" = service ] && phase=normal; if [ "$live" -eq 1 ]; then if [ "$(core_registry_field "$module" 2)" = service ]; then CORE_CONFIG_ROOT="$root" CORE_STATE_ROOT="$root" core_service_reapply "$root" "$module"; else CORE_REAPPLY_ID="$module" CORE_BOOT_ID=${CORE_BOOT_ID:-manual-$(date +%s)} CORE_CONFIG_ROOT="$root" CORE_PREFIX="$root/usr/lib/ps5-cachyos-tools" CORE_STATE_ROOT="$root" CORE_RUN_ROOT="$root" "$root/usr/lib/ps5-cachyos-tools/boot-runner" "$phase"; fi; else [ "$(core_registry_field "$module" 2)" != service ] || { core_die 'reapply offline non supportato per i servizi'; return 1; }; core_txn_lock "$root" || return 1; mkdir -p "$root/var/lib/ps5-cachyos-tools/state/reapply" || return 1; request="$root/var/lib/ps5-cachyos-tools/state/reapply/$module.request"; request_tmp=$(mktemp "$root/var/lib/ps5-cachyos-tools/state/reapply/.$module.request.XXXXXX") || return 1; printf 'id=%s\nphase=%s\nrevision=%s\nrequested_at=%s\n' "$module" "$phase" "$(core_registry_field "$module" 5)" "$(date +%s%N)" > "$request_tmp" && mv -f -- "$request_tmp" "$request" || { rm -f -- "$request_tmp"; return 1; }; core_log "reapply pianificato per il prossimo boot: $module"; fi;;
        status) root=${root:-/}; [ -d "$root/var/lib/ps5-cachyos-tools/state/modules" ] || return 1; core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null 2>&1 || true; for id in "${CORE_MODULE_IDS[@]}"; do f="$root/var/lib/ps5-cachyos-tools/state/modules/$id.state"; printf '%s: installed=%s enabled=%s type=%s policy=%s ' "$id" "$(test -f "$root/usr/lib/ps5-cachyos-tools/modules/$id/module.conf" && echo yes || echo no)" "$(core_registry_field "$id" 1 2>/dev/null || echo unknown)" "$(core_registry_field "$id" 2 2>/dev/null || echo unknown)" "$(core_registry_field "$id" 3 2>/dev/null || echo unknown)"; [ -f "$f" ] && awk -F= '$1=="status"||$1=="last_attempt_at"||$1=="completed_at"||$1=="last_boot_id"||$1=="reapply_requested"{printf "%s=%s ",$1,$2}' "$f"; [ -f "$root/var/lib/ps5-cachyos-tools/state/reapply/$id.request" ] && printf 'reapply_requested=true '; printf '\n'; done;;
        *) usage; return 2;;
    esac
}
main "$@"
