#!/usr/bin/env bash
set -u
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
if [ -f "$SCRIPT_DIR/../lib/core/log.sh" ]; then BASE=$(cd "$SCRIPT_DIR/.." && pwd); else BASE=/usr/lib/ps5-cachyos-tools; fi
source "$BASE/lib/core/log.sh" 2>/dev/null || source "$BASE/core/log.sh"; source "$BASE/lib/core/target.sh" 2>/dev/null || source "$BASE/core/target.sh"; source "$BASE/lib/core/registry.sh" 2>/dev/null || source "$BASE/core/registry.sh"; source "$BASE/lib/core/dependencies.sh" 2>/dev/null || source "$BASE/core/dependencies.sh"; source "$BASE/lib/core/installer.sh" 2>/dev/null || source "$BASE/core/installer.sh"; source "$BASE/lib/core/service.sh" 2>/dev/null || source "$BASE/core/service.sh"; source "$BASE/lib/modules/fan.sh" 2>/dev/null || source "$BASE/modules/fan.sh"
usage() { printf '%s\n' 'uso: ps5-cachyos-tools list | install (--root ROOT [--boot BOOT]|--live) [--module ID] [--dry-run] [--no-start] | check --root ROOT | status [--root ROOT|--live] | reset ID --root ROOT | reapply ID [--root ROOT|--live] | remove --module ID --root ROOT'; }
need_arg() { [ "$#" -ge 2 ] && [ -n "$2" ] && { printf '%s\n' "$2"; return 0; }; core_die "valore mancante per $1"; return 2; }
main() {
    local cmd=${1-} root='' boot='' module='' live=0 dry=0 no_start=0; shift || true
    if [ "$cmd" = reset ] && [ "$#" -gt 0 ] && [[ "$1" != --* ]]; then module=$1; shift; fi
    while [ "$#" -gt 0 ]; do case "$1" in --root) root=$(need_arg "$1" "${2-}") || return $?; shift 2;; --boot) boot=$(need_arg "$1" "${2-}") || return $?; shift 2;; --live) live=1; shift;; --module) module=$(need_arg "$1" "${2-}") || return $?; shift 2;; --dry-run) dry=1; shift;; --no-start) no_start=1; shift;; --force|--all) core_die "$1 richiede un comando esplicito: usare reapply o --module"; return 2;; --help|-h) usage; return 0;; *) core_die "opzione sconosciuta: $1"; return 2;; esac; done
    case "$cmd" in
        list) core_registry_discover "$BASE/modules"; core_registry_validate_dependencies;;
        install) if [ "$live" -eq 1 ]; then [ -z "$root" ] || { core_die '--live e --root sono incompatibili'; return 2; }; root=$(core_target_validate_live) || return 1; else [ -n "$root" ] || { core_die '--root richiesto in modalità offline'; return 2; }; root=$(core_target_validate_offline "$root" "$boot") || return 1; [ -z "$boot" ] || boot=$(core_target_boot_path "$root" "$boot") || { core_die 'partizione boot non associata alla rootfs target'; return 1; }; fi; [ "$dry" -eq 0 ] || { core_registry_discover "$BASE/modules" >/dev/null || return 1; core_registry_validate_dependencies || return 1; core_log "dry-run: target=$root module=${module:-all} boot=${boot:-none}"; return 0; }; PS5_TOOLS_NO_START=$no_start CORE_CONFIG_ROOT=$root CORE_BOOT_TARGET=$boot CORE_INSTALL_MODE=$([ "$live" -eq 1 ] && echo live || echo offline) core_install "$root" "$BASE" "$module" || return 1;;
        check) [ -n "$root" ] || { core_die '--root richiesto'; return 2; }; root=$(core_target_validate_offline "$root") || return 1; core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null || return 1; for id in "${CORE_MODULE_IDS[@]}"; do if [ -x "$root/usr/lib/ps5-cachyos-tools/modules/$id/check.sh" ]; then "$root/usr/lib/ps5-cachyos-tools/modules/$id/check.sh" "$root" || return 1; fi; done;;
        reset) [[ "$module" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { core_die 'ID modulo non valido'; return 2; }; if [ "$live" -eq 1 ]; then root=$(core_target_validate_live) || return 1; else root=$(core_target_validate_offline "$root") || return 1; fi; rm -f -- "$root/var/lib/ps5-cachyos-tools/state/modules/$module.state";;
        remove) [ -n "$module" ] || { core_die '--module richiesto'; return 2; }; root=$(core_target_validate_offline "$root") || return 1; core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null || return 1; [ "${CORE_MODULE[$module]+x}" = x ] || return 1; hook="$root/usr/lib/ps5-cachyos-tools/modules/$module/remove.sh"; [ -x "$hook" ] || { core_die "modulo senza remove hook: $module"; return 1; }; CORE_INSTALL_MODE=offline CORE_TARGET_ROOT="$root" CORE_MODULE_ID="$module" "$hook" "$root" 0;;
        reapply) [ -n "$module" ] || { core_die 'ID modulo richiesto'; return 2; }; if [ "$live" -eq 1 ]; then root=$(core_target_validate_live) || return 1; else root=$(core_target_validate_offline "$root") || return 1; fi; state="$root/var/lib/ps5-cachyos-tools/state/modules/$module.state"; rm -f -- "$state" || return 1; CORE_BOOT_ID=${CORE_BOOT_ID:-manual-$(date +%s)} CORE_PREFIX="$root/usr/lib/ps5-cachyos-tools" CORE_STATE_ROOT="$root" CORE_RUN_ROOT="$root" "$root/usr/lib/ps5-cachyos-tools/boot-runner" normal;;
        status) root=${root:-/}; [ -d "$root/var/lib/ps5-cachyos-tools/state/modules" ] || return 1; core_registry_discover "$root/usr/lib/ps5-cachyos-tools/modules" >/dev/null 2>&1 || true; for id in "${CORE_MODULE_IDS[@]}"; do f="$root/var/lib/ps5-cachyos-tools/state/modules/$id.state"; printf '%s: installed=%s enabled=%s type=%s policy=%s ' "$id" "$(test -f "$root/usr/lib/ps5-cachyos-tools/modules/$id/module.conf" && echo yes || echo no)" "$(core_registry_field "$id" 1 2>/dev/null || echo unknown)" "$(core_registry_field "$id" 2 2>/dev/null || echo unknown)" "$(core_registry_field "$id" 3 2>/dev/null || echo unknown)"; [ -f "$f" ] && awk -F= '$1=="status"||$1=="last_attempt_at"||$1=="completed_at"||$1=="last_boot_id"{printf "%s=%s ",$1,$2}' "$f"; printf '\n'; done;;
        *) usage; return 2;;
    esac
}
main "$@"
